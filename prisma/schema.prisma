// Schema Prisma — usado para gerar o client e as migrations/tabelas.
// As operações do repositório são feitas via raw queries ($queryRaw/$executeRaw).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums nativos do Postgres. Os valores espelham exatamente os enums do domínio
// (match.aggregate.ts, competition.entity.ts, player.entity.ts), de modo que o
// banco também passa a validar os valores permitidos.

enum CompetitionType {
  LEAGUE
  CUP
}

enum PlayerPosition {
  GOALKEEPER
  DEFENDER
  MIDFIELDER
  FORWARD
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  HALF_TIME
  FINISHED
}

enum MatchEventType {
  GOAL
  OWN_GOAL
  PENALTY_KICK
  PENALTY_SHOOTOUT
  CORNER_KICK
  FREE_KICK
  DIRECT_FREE_KICK
  INDIRECT_FREE_KICK
  THROW_IN
  GOAL_KICK
  SUBSTITUTION
  MATCH_STARTED
  HALF_TIME
  MATCH_FINISHED
}

model Team {
  id        String @id
  name      String
  shortName String @map("short_name")

  @@map("teams")
}

model Competition {
  id   String          @id
  name String
  type CompetitionType

  @@map("competitions")
}

model Player {
  id          String @id
  teamId      String @map("team_id")
  name        String
  shirtNumber Int            @map("shirt_number")
  position    PlayerPosition

  @@index([teamId])
  @@map("players")
}

model Match {
  id            String      @id
  competitionId String      @map("competition_id")
  status        MatchStatus
  minute        Int
  startedAt  DateTime? @map("started_at")
  finishedAt DateTime? @map("finished_at")
  updatedAt  DateTime  @map("updated_at")
  sequence   Int
  teamAId    String    @map("team_a_id")
  teamBId    String    @map("team_b_id")
  teamAGoals Int       @map("team_a_goals")
  teamBGoals Int       @map("team_b_goals")

  @@map("matches")
}

model Goal {
  id         String @id
  matchId    String @map("match_id")
  playerId   String @map("player_id")
  playerName String @map("player_name")
  teamId     String @map("team_id")
  minute     Int

  @@index([matchId])
  @@map("goals")
}

model MatchEvent {
  id            String @id
  matchId       String         @map("match_id")
  competitionId String         @map("competition_id")
  sequence      Int
  type          MatchEventType
  minute        Int
  payload       Json

  @@unique([matchId, sequence])
  @@index([competitionId])
  @@map("match_events")
}
