{
  "name": "fifa-score-board-clone",
  "version": "1.0.0",
  "description": "FIFA score board clone built with Fastify and Clean Architecture",
  "main": "dist/main/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main/server.ts",
    "worker:dev": "tsx watch src/main/sqs-worker.ts",
    "seed": "tsx prisma/seed.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "up": "docker compose up -d --build",
    "up:seed": "docker compose up -d --build && docker compose run --rm seed",
    "seed:docker": "docker compose run --rm seed",
    "simulate": "bash scripts/simulate-match.sh",
    "logs": "docker compose logs -f app",
    "down": "docker compose down",
    "down:clean": "docker compose down -v"
  },
  "keywords": [
    "fastify",
    "clean-architecture",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sns": "^3.1138.0",
    "@aws-sdk/client-sqs": "^3.1138.0",
    "@prisma/client": "^6.19.3",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.8",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "prisma@6.19.3": true
  }
}
